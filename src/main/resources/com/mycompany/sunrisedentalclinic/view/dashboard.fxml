<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mycompany.sunrisedentalclinic.controller.DashboardController"
            stylesheets="@clinic.css">

    <!-- ================= HEADER ================= -->
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="shell-header">
            <HBox prefWidth="190" minWidth="190" maxWidth="190" spacing="8" alignment="CENTER_LEFT" styleClass="sidebar-brand">
                <ImageView fitWidth="44" fitHeight="44" preserveRatio="true" smooth="true">
                    <image>
                        <Image url="@dental_logo.png"/>
                    </image>
                </ImageView>
                <VBox spacing="0">
                    <Label text="SUNRISE" styleClass="sidebar-brand-title"/>
                    <Label text="DENTAL CLINIC" styleClass="sidebar-brand-subtitle"/>
                </VBox>
            </HBox>

            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="top-toolbar" HBox.hgrow="ALWAYS">
                <Label text="☰" styleClass="menu-icon"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <TextField fx:id="globalSearch" promptText="Search sections..." prefWidth="245" prefHeight="38" onAction="#searchNavigation" styleClass="top-search"/>
                <Button text="Search" onAction="#searchNavigation" styleClass="search-button"/>
                <Label fx:id="lblUser" styleClass="user-chip"/>
            </HBox>
        </HBox>
    </top>


    <!-- ================= MAIN CONTENT ================= -->
    <center>
        <HBox>
            <VBox prefWidth="190" minWidth="190" maxWidth="190" spacing="4" styleClass="navigation-sidebar">
                <Label text="MAIN MENU" styleClass="navigation-caption"/>
                <Button fx:id="navOverview" text="Overview" onAction="#showOverview" maxWidth="Infinity" styleClass="nav-button,selected"/>
                <Button fx:id="navUsers" text="Users" onAction="#showUsers" maxWidth="Infinity" styleClass="nav-button"/>
                <Button fx:id="navPatients" text="Patients" onAction="#showPatients" maxWidth="Infinity" styleClass="nav-button"/>
                <Button fx:id="navAppointments" text="Appointments" onAction="#showAppointments" maxWidth="Infinity" styleClass="nav-button"/>
                <Button fx:id="navBilling" text="Billing" onAction="#showBilling" maxWidth="Infinity" styleClass="nav-button"/>
                <Button fx:id="navDentists" text="Dentists" onAction="#showDentists" maxWidth="Infinity" styleClass="nav-button"/>
                <Button fx:id="navTreatments" text="Treatments" onAction="#showTreatments" maxWidth="Infinity" styleClass="nav-button"/>
                <Button fx:id="navHelp" text="Help" onAction="#showHelp" maxWidth="Infinity" styleClass="nav-button"/>
                <Button fx:id="navTickets" text="Support Tickets" onAction="#showTickets" maxWidth="Infinity" styleClass="nav-button"/>
                <Button fx:id="navReports" text="Reports" onAction="#showReports" maxWidth="Infinity" styleClass="nav-button"/>
                <Pane VBox.vgrow="ALWAYS"/>
                <VBox spacing="6" styleClass="sidebar-actions">
                    <Button text="Logout" onAction="#logout" maxWidth="Infinity" styleClass="sidebar-action-button"/>
                    <Button text="Exit" onAction="#exit" maxWidth="Infinity" styleClass="sidebar-action-button,sidebar-exit-button"/>
                </VBox>
                <Label text="Sunrise Dental Clinic" styleClass="sidebar-footer"/>
            </VBox>

            <TabPane fx:id="tabs" tabClosingPolicy="UNAVAILABLE" styleClass="content-tabs" HBox.hgrow="ALWAYS">

                <tabs>

                    <!-- ================= OVERVIEW ================= -->

                    <Tab fx:id="tabOverview" text="Overview">
                        <content>
                            <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" styleClass="dashboard-scroll">
                                <VBox spacing="18" styleClass="content-page">
                                    <VBox spacing="4">
                                        <Label text="Dashboard Overview" styleClass="page-title"/>
                                        <Label text="Monitor clinic activity and daily operations in one place." styleClass="muted"/>
                                    </VBox>

                                    <HBox spacing="14">
                                        <VBox spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
                                            <Label text="TOTAL APPOINTMENTS" styleClass="metric-label"/>
                                            <Label fx:id="metricAppointments" text="0" styleClass="metric-value"/>
                                            <Label text="Current results" styleClass="metric-note"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
                                            <Label text="TODAY'S VISITS" styleClass="metric-label"/>
                                            <Label fx:id="metricToday" text="0" styleClass="metric-value"/>
                                            <Label text="Scheduled today" styleClass="metric-note"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
                                            <Label text="PATIENTS" styleClass="metric-label"/>
                                            <Label fx:id="metricPatients" text="0" styleClass="metric-value"/>
                                            <Label text="Registered records" styleClass="metric-note"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
                                            <Label text="TREATMENTS" styleClass="metric-label"/>
                                            <Label fx:id="metricTreatments" text="0" styleClass="metric-value"/>
                                            <Label text="Available services" styleClass="metric-note"/>
                                        </VBox>
                                    </HBox>

                                    <HBox spacing="14" prefHeight="285">
                                        <VBox spacing="8" styleClass="chart-card" HBox.hgrow="ALWAYS">
                                            <Label text="Appointments by Date" styleClass="card-title"/>
                                            <BarChart fx:id="appointmentsChart" legendVisible="false" animated="false" VBox.vgrow="ALWAYS">
                                                <xAxis>
                                                    <CategoryAxis label="Date"/>
                                                </xAxis>
                                                <yAxis>
                                                    <NumberAxis label="Appointments" forceZeroInRange="true" tickUnit="1"/>
                                                </yAxis>
                                            </BarChart>
                                        </VBox>
                                        <VBox spacing="8" styleClass="chart-card" HBox.hgrow="ALWAYS">
                                            <Label text="Appointment Status" styleClass="card-title"/>
                                            <PieChart fx:id="statusChart" labelsVisible="true" animated="false" VBox.vgrow="ALWAYS"/>
                                        </VBox>
                                    </HBox>

                                    <VBox spacing="10" styleClass="section-card" VBox.vgrow="ALWAYS">
                                        <HBox alignment="CENTER_LEFT">
                                            <VBox spacing="2">
                                                <Label text="Upcoming Appointments" styleClass="card-title"/>
                                                <Label text="Latest operational appointment data" styleClass="muted"/>
                                            </VBox>
                                            <Pane HBox.hgrow="ALWAYS"/>
                                            <Button text="Refresh data" onAction="#refreshAll" styleClass="secondary"/>
                                        </HBox>
                                        <TableView fx:id="overviewTable" minWidth="0" maxWidth="Infinity" prefHeight="240" VBox.vgrow="ALWAYS"/>
                                    </VBox>
                                </VBox>
                            </ScrollPane>
                        </content>
                    </Tab>

                    <!-- ================= USERS ================= -->

                    <Tab fx:id="tabUsers"
                         text="Users">

                        <content>

                            <VBox spacing="12" styleClass="content-page,user-page">
                                <HBox alignment="CENTER_LEFT">
                                    <VBox spacing="2">
                                        <Label text="Users" styleClass="page-title"/>
                                        <Label text="Create accounts and manage access to the clinic system." styleClass="muted"/>
                                    </VBox>
                                </HBox>

                                <VBox spacing="12" styleClass="section-card,user-create-card">
                                    <HBox alignment="CENTER_LEFT">
                                        <VBox spacing="2">
                                            <Label text="Add a new user" styleClass="card-title"/>
                                            <Label text="Enter the account details below." styleClass="muted,small-copy"/>
                                        </VBox>
                                    </HBox>
                                    <GridPane hgap="10" vgap="10">
                                        <columnConstraints>
                                            <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                                            <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                                            <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                                            <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                                        </columnConstraints>
                                        <TextField fx:id="uUsername" promptText="Username *" GridPane.columnIndex="0" GridPane.rowIndex="0" maxWidth="Infinity"/>
                                        <PasswordField fx:id="uPassword" promptText="Password *" GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="Infinity"/>
                                        <TextField fx:id="uName" promptText="Full name *" GridPane.columnIndex="2" GridPane.rowIndex="0" maxWidth="Infinity"/>
                                        <TextField fx:id="uEmail" promptText="Email address" GridPane.columnIndex="3" GridPane.rowIndex="0" maxWidth="Infinity"/>
                                        <ComboBox fx:id="uRole" promptText="Select role *" GridPane.columnIndex="0" GridPane.rowIndex="1" maxWidth="Infinity"/>
                                        <TextField fx:id="uDentistSpecialization" promptText="Dentist specialization *" GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.columnSpan="2" maxWidth="Infinity"/>
                                        <Button text="Create user" onAction="#addUser" styleClass="primary-large" GridPane.columnIndex="3" GridPane.rowIndex="1" maxWidth="Infinity"/>
                                    </GridPane>
                                </VBox>

                                <VBox spacing="10" styleClass="section-card,user-list-card" VBox.vgrow="ALWAYS">
                                    <HBox alignment="CENTER_LEFT">
                                        <VBox spacing="2">
                                            <Label text="All users" styleClass="card-title"/>
                                            <Label text="Select a row to edit or remove an account." styleClass="muted,small-copy"/>
                                        </VBox>
                                        <Pane HBox.hgrow="ALWAYS"/>
                                        <HBox spacing="8">
                                            <Button text="Edit user" onAction="#editUser" styleClass="secondary"/>
                                            <Button text="Delete" onAction="#deleteUser" styleClass="danger"/>
                                        </HBox>
                                    </HBox>
                                    <TableView fx:id="userTable" minWidth="0" maxWidth="Infinity" VBox.vgrow="ALWAYS" styleClass="user-table" />
                                </VBox>
                            </VBox>

                        </content>

                    </Tab>


                    <!-- ================= PATIENTS ================= -->

                    <Tab fx:id="tabPatients"
                         text="Patients">

                        <content>

                            <VBox spacing="10" styleClass="content-page">
                                <VBox spacing="2">
                                    <Label text="Patients" styleClass="page-title"/>
                                    <Label text="Register patients and keep their contact details up to date." styleClass="muted"/>
                                </VBox>

                                <VBox spacing="12" styleClass="section-card,user-create-card">
                                    <Label text="Add a new patient" styleClass="card-title"/>
                                    <GridPane hgap="10" vgap="10">
                                        <columnConstraints>
                                            <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                                            <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                                            <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                                            <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                                        </columnConstraints>
                                        <TextField fx:id="pName" promptText="Full name *" GridPane.columnIndex="0" maxWidth="Infinity"/>
                                        <TextField fx:id="pAddress" promptText="Address" GridPane.columnIndex="1" maxWidth="Infinity"/>
                                        <TextField fx:id="pContact" promptText="Contact number *" GridPane.columnIndex="2" maxWidth="Infinity"/>
                                        <TextField fx:id="pEmail" promptText="Email address" GridPane.columnIndex="3" maxWidth="Infinity"/>
                                        <ComboBox fx:id="pGender" promptText="Gender *" GridPane.columnIndex="0" GridPane.rowIndex="1" maxWidth="Infinity"/>
                                        <Button text="Add patient" onAction="#addPatient" styleClass="primary-large" GridPane.columnIndex="3" GridPane.rowIndex="1" maxWidth="Infinity"/>
                                    </GridPane>
                                </VBox>

                                <VBox spacing="10" styleClass="section-card,user-list-card" VBox.vgrow="ALWAYS">
                                    <HBox alignment="CENTER_LEFT">
                                        <VBox spacing="2">
                                            <Label text="All patients" styleClass="card-title"/>
                                            <Label text="Select a row to edit or remove a patient." styleClass="muted,small-copy"/>
                                        </VBox>
                                        <Pane HBox.hgrow="ALWAYS"/>
                                        <HBox spacing="8">
                                            <Button text="View details" onAction="#viewPatientDetails" styleClass="secondary"/>
                                            <Button text="Edit patient" onAction="#editPatient" styleClass="secondary"/>
                                            <Button text="Delete" onAction="#deletePatient" styleClass="danger"/>
                                        </HBox>
                                    </HBox>
                                    <TableView fx:id="patientTable" minWidth="0" maxWidth="Infinity" VBox.vgrow="ALWAYS"/>
                                </VBox>
                            </VBox>

                        </content>

                    </Tab>


                    <!-- ================= APPOINTMENTS ================= -->

                    <Tab fx:id="tabAppointments"
                         text="Appointments">

                        <content>

                            <VBox spacing="16" styleClass="content-page">

                                <VBox spacing="2">
                                    <Label text="Appointments" styleClass="page-title"/>
                                    <Label text="Schedule and manage clinic appointments." styleClass="muted"/>
                                </VBox>

                                <!-- Search -->

                                <HBox spacing="8">

                                    <TextField fx:id="aSearch"
                                               promptText="Search appointment number or patient name"
                                               prefWidth="310"/>

                                    <Button text="Search / Refresh"
                                            onAction="#refreshAppointments"/>

                                    <Pane HBox.hgrow="ALWAYS"/>
                                    <Button text="Edit appointment" onAction="#editAppointment" styleClass="secondary"/>
                                    <Button text="Delete" onAction="#deleteAppointment" styleClass="danger"/>

                                </HBox>


                                <!-- Appointment Form -->

                                <GridPane hgap="8" vgap="8" styleClass="section-card" maxWidth="Infinity">

                                    <ComboBox fx:id="aPatientSearch"
                                              promptText="Search registered patient by name, contact or email"
                                              editable="true"
                                              onAction="#selectAppointmentPatient"
                                              maxWidth="Infinity"
                                              GridPane.columnIndex="0"
                                              GridPane.rowIndex="0"
                                              GridPane.columnSpan="4"/>



                                    <TextField fx:id="aPatientName"
                                               promptText="Patient Name"
                                               GridPane.columnIndex="0"
                                               GridPane.rowIndex="1"/>

                                    <TextField fx:id="aAddress"
                                               promptText="Address"
                                               GridPane.columnIndex="2"
                                               GridPane.rowIndex="1"/>

                                    <TextField fx:id="aContact"
                                               promptText="Contact"
                                               GridPane.columnIndex="3"
                                               GridPane.rowIndex="1"/>


                                    <TextField fx:id="aEmail"
                                               promptText="Email"
                                               GridPane.columnIndex="0"
                                               GridPane.rowIndex="2"/>

                                    <ComboBox fx:id="aGender"
                                              promptText="Gender *"
                                              maxWidth="Infinity"
                                              GridPane.columnIndex="1"
                                              GridPane.rowIndex="1"/>

                                    <ComboBox fx:id="aDentist"
                                              promptText="Dentist"
                                              onAction="#showDentistAvailability"
                                              GridPane.columnIndex="1"
                                              GridPane.rowIndex="2"/>

                                    <ComboBox fx:id="aTreatment"
                                              promptText="Treatment"
                                              GridPane.columnIndex="2"
                                              GridPane.rowIndex="2"/>

                                    <DatePicker fx:id="aDate"
                                                GridPane.columnIndex="3"
                                                GridPane.rowIndex="2"/>


                                    <TextField fx:id="aTime"
                                               promptText="Time HH:mm"
                                               GridPane.columnIndex="0"
                                               GridPane.rowIndex="3"/>

                                    <TextField fx:id="aNotes"
                                               promptText="Notes"
                                               GridPane.columnIndex="1"
                                               GridPane.rowIndex="3"
                                               GridPane.columnSpan="2"/>

                                    <Button text="Register Appointment"
                                            onAction="#registerAppointment"
                                            GridPane.columnIndex="3"
                                            GridPane.rowIndex="3"/>

                                    <Label fx:id="aDentistAvailability" text="Select a dentist to see available hours"
                                           styleClass="availability-hint" GridPane.columnIndex="0" GridPane.rowIndex="4"
                                           GridPane.columnSpan="4"/>

                                </GridPane>


                                <TableView fx:id="apptTable" minWidth="0" maxWidth="Infinity"
                                           VBox.vgrow="ALWAYS"/>

                            </VBox>

                        </content>

                    </Tab>


                    <!-- ================= BILLING ================= -->

                    <Tab fx:id="tabBilling"
                         text="Billing">

                        <content>

                            <VBox spacing="10" styleClass="content-page,billing-page">
                                <VBox spacing="2">
                                    <Label text="Billing &amp; payments" styleClass="page-title"/>
                                    <Label text="Record a payment and create a printable receipt." styleClass="muted"/>
                                </VBox>

                                <HBox spacing="12" VBox.vgrow="ALWAYS">
                                    <VBox spacing="14" styleClass="section-card,payment-card" HBox.hgrow="ALWAYS">
                                        <VBox spacing="2">
                                            <Label text="Payment details" styleClass="card-title"/>
                                            <Label text="Choose an appointment and payment method." styleClass="muted,small-copy"/>
                                        </VBox>

                                        <VBox spacing="6">
                                            <Label text="Appointment" styleClass="field-label"/>
                                            <ComboBox fx:id="bAppointment" promptText="Select appointment" onAction="#updateBillingSummary" maxWidth="Infinity"/>
                                        </VBox>

                                        <GridPane hgap="10" vgap="10">
                                            <columnConstraints>
                                                <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                                                <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                                            </columnConstraints>
                                            <VBox spacing="6" GridPane.columnIndex="0">
                                                <Label text="Consultation fee (Rs.)" styleClass="field-label"/>
                                                <TextField fx:id="bConsultation" promptText="0.00"/>
                                            </VBox>
                                            <VBox spacing="6" GridPane.columnIndex="1">
                                                <Label text="Payment method" styleClass="field-label"/>
                                                <ComboBox fx:id="bPaymentMethod" promptText="Cash or card" onAction="#updateBillingMethod" maxWidth="Infinity"/>
                                            </VBox>
                                        </GridPane>

                                        <VBox fx:id="bCardFields" spacing="10" visible="false" managed="false" styleClass="card-details-box">
                                            <Label text="Card details" styleClass="field-label"/>
                                            <TextField fx:id="bCardHolder" promptText="Cardholder name"/>
                                            <TextField fx:id="bCardNumber" promptText="Card number"/>
                                            <HBox spacing="10">
                                                <TextField fx:id="bCardExpiry" promptText="MM/YY" HBox.hgrow="ALWAYS"/>
                                                <PasswordField fx:id="bCardCvv" promptText="CVV" HBox.hgrow="ALWAYS"/>
                                            </HBox>
                                            <Label text="Demo payment: card details are not sent to a payment provider." styleClass="muted,small-copy" wrapText="true"/>
                                        </VBox>

                                        <VBox spacing="8" styleClass="billing-summary">
                                            <HBox><Label text="Treatment charge" styleClass="muted"/><Pane HBox.hgrow="ALWAYS"/><Label fx:id="bTreatmentAmount" text="Rs. 0.00" styleClass="summary-value"/></HBox>
                                            <HBox><Label text="Total payment" styleClass="total-label"/><Pane HBox.hgrow="ALWAYS"/><Label fx:id="bTotalAmount" text="Rs. 0.00" styleClass="total-value"/></HBox>
                                        </VBox>

                                        <Button text="Complete payment" onAction="#processPayment" maxWidth="Infinity" styleClass="primary-large"/>
                                    </VBox>

                                    <VBox spacing="10" styleClass="section-card,receipt-card" HBox.hgrow="ALWAYS">
                                        <HBox alignment="CENTER_LEFT">
                                            <VBox spacing="2">
                                                <Label text="Receipt preview" styleClass="card-title"/>
                                                <Label text="Available after payment is completed." styleClass="muted,small-copy"/>
                                            </VBox>
                                            <Pane HBox.hgrow="ALWAYS"/>
                                            <HBox spacing="8">
                                                <Button fx:id="bPrintButton" text="Print" onAction="#printReceipt" styleClass="secondary" disable="true"/>
                                                <Button fx:id="bPdfButton" text="Open PDF" onAction="#openReceiptPdf" styleClass="secondary" disable="true"/>
                                            </HBox>
                                        </HBox>
                                        <TextArea fx:id="bReceipt" editable="false" promptText="Your receipt will appear here" styleClass="receipt,receipt-preview" VBox.vgrow="ALWAYS"/>
                                    </VBox>
                                </HBox>
                            </VBox>

                        </content>

                    </Tab>


                    <!-- ================= DENTISTS ================= -->
                    <Tab fx:id="tabDentists" text="Dentists">
                        <content>
                            <VBox spacing="12" styleClass="content-page">
                                <VBox spacing="2">
                                    <Label text="Dentists" styleClass="page-title"/>
                                    <Label text="Manage dentist profiles and daily appointment hours." styleClass="muted"/>
                                </VBox>
                                <VBox spacing="12" styleClass="section-card,user-create-card">
                                    <Label text="Set dentist availability" styleClass="card-title"/>
                                    <GridPane hgap="10" vgap="10">
                                        <columnConstraints>
                                            <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                                            <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                                            <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                                            <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                                        </columnConstraints>
                                        <ComboBox fx:id="dDentist" promptText="Select registered dentist *" maxWidth="Infinity" GridPane.columnIndex="0"/>
                                        <TextField fx:id="dStartTime" promptText="Start time HH:mm *" GridPane.columnIndex="1"/>
                                        <TextField fx:id="dEndTime" promptText="End time HH:mm *" GridPane.columnIndex="2"/>
                                        <Button text="Save availability" onAction="#saveDentistAvailability" styleClass="primary-large" maxWidth="Infinity" GridPane.columnIndex="3"/>
                                    </GridPane>
                                </VBox>
                                <VBox spacing="10" styleClass="section-card,user-list-card" VBox.vgrow="ALWAYS">
                                    <HBox alignment="CENTER_LEFT">
                                        <VBox spacing="2">
                                            <Label text="Dentist details" styleClass="card-title"/>
                                            <Label text="Availability is used when scheduling appointments." styleClass="muted,small-copy"/>
                                        </VBox>
                                        <Pane HBox.hgrow="ALWAYS"/>
                                        <Button text="Edit working hours" onAction="#editDentist" styleClass="secondary"/>
                                    </HBox>
                                    <TableView fx:id="dentistTable" VBox.vgrow="ALWAYS"/>
                                </VBox>
                            </VBox>
                        </content>
                    </Tab>


                    <!-- ================= TREATMENTS ================= -->

                    <Tab fx:id="tabTreatments"
                         text="Treatments">

                        <content>

                            <VBox spacing="10" styleClass="content-page">
                                <VBox spacing="2">
                                    <Label text="Treatments" styleClass="page-title"/>
                                    <Label text="Manage the clinic's services and treatment prices." styleClass="muted"/>
                                </VBox>

                                <VBox spacing="12" styleClass="section-card,user-create-card">
                                    <Label text="Add a new treatment" styleClass="card-title"/>
                                    <GridPane hgap="10" vgap="10">
                                        <columnConstraints>
                                            <ColumnConstraints percentWidth="28" hgrow="ALWAYS"/>
                                            <ColumnConstraints percentWidth="44" hgrow="ALWAYS"/>
                                            <ColumnConstraints percentWidth="28" hgrow="ALWAYS"/>
                                        </columnConstraints>
                                        <TextField fx:id="tName" promptText="Treatment name *" GridPane.columnIndex="0" maxWidth="Infinity"/>
                                        <TextField fx:id="tDescription" promptText="Description" GridPane.columnIndex="1" maxWidth="Infinity"/>
                                        <TextField fx:id="tCost" promptText="Cost (Rs.) *" GridPane.columnIndex="2" maxWidth="Infinity"/>
                                        <Button text="Add treatment" onAction="#addTreatment" styleClass="primary-large" GridPane.columnIndex="2" GridPane.rowIndex="1" maxWidth="Infinity"/>
                                    </GridPane>
                                </VBox>

                                <VBox spacing="10" styleClass="section-card,user-list-card" VBox.vgrow="ALWAYS">
                                    <HBox alignment="CENTER_LEFT">
                                        <VBox spacing="2">
                                            <Label text="All treatments" styleClass="card-title"/>
                                            <Label text="Select a row to edit or delete a treatment." styleClass="muted,small-copy"/>
                                        </VBox>
                                        <Pane HBox.hgrow="ALWAYS"/>
                                        <HBox spacing="8">
                                            <Button text="Edit treatment" onAction="#editTreatment" styleClass="secondary"/>
                                            <Button text="Delete" onAction="#deleteTreatment" styleClass="danger"/>
                                        </HBox>
                                    </HBox>
                                    <TableView fx:id="treatmentTable" minWidth="0" maxWidth="Infinity" VBox.vgrow="ALWAYS"/>
                                </VBox>
                            </VBox>

                        </content>

                    </Tab>


                    <!-- ================= HELP ================= -->

                    <Tab fx:id="tabHelp"
                         text="Help">

                        <content>

                            <VBox spacing="14" styleClass="content-page,help-page">
                                <VBox spacing="2">
                                    <Label text="Help center" styleClass="page-title"/>
                                    <Label text="Browse clinic guides and common workflows." styleClass="muted"/>
                                </VBox>
                                <HBox spacing="14" VBox.vgrow="ALWAYS">
                                    <VBox spacing="10" prefWidth="300" styleClass="section-card,help-topic-card">
                                        <Label text="Topics" styleClass="card-title"/>
                                        <Label text="Select a topic to read" styleClass="muted,small-copy"/>
                                        <ListView fx:id="helpList" VBox.vgrow="ALWAYS"/>
                                    </VBox>
                                    <VBox spacing="12" styleClass="section-card,help-content-card" HBox.hgrow="ALWAYS">
                                        <Label text="Topic details" styleClass="card-title"/>
                                        <TextField fx:id="hTitle" promptText="Topic title *" styleClass="help-title-input"/>
                                        <TextArea fx:id="hContent" promptText="Write clear help instructions here *"
                                                  wrapText="true" styleClass="help-content-input" VBox.vgrow="ALWAYS"/>
                                        <HBox fx:id="helpAdminActions" spacing="8" alignment="CENTER_RIGHT">
                                            <Button text="New topic" onAction="#newHelpTopic" styleClass="secondary"/>
                                            <Button text="Add topic" onAction="#addHelp" styleClass="primary-large"/>
                                            <Button text="Delete selected" onAction="#deleteHelp" styleClass="danger"/>
                                        </HBox>
                                    </VBox>
                                </HBox>
                            </VBox>

                        </content>

                    </Tab>


                    <!-- ================= SUPPORT TICKETS ================= -->

                    <Tab fx:id="tabTickets"
                         text="Support Tickets">

                        <content>

                            <VBox spacing="10" styleClass="content-page">
                                <HBox alignment="CENTER_LEFT">
                                    <VBox spacing="2">
                                        <Label text="Support tickets" styleClass="page-title"/>
                                        <Label text="Create requests and follow their progress." styleClass="muted"/>
                                    </VBox>
                                    <Pane HBox.hgrow="ALWAYS"/>
                                    <Button text="Refresh" onAction="#refreshTickets" styleClass="secondary"/>
                                </HBox>

                                <VBox spacing="10" styleClass="section-card,user-create-card">
                                    <Label text="Create a support ticket" styleClass="card-title"/>
                                    <GridPane hgap="10" vgap="10">
                                        <columnConstraints>
                                            <ColumnConstraints percentWidth="70" hgrow="ALWAYS"/>
                                            <ColumnConstraints percentWidth="30" hgrow="ALWAYS"/>
                                        </columnConstraints>
                                        <TextField fx:id="sSubject" promptText="Subject *" GridPane.columnIndex="0" maxWidth="Infinity"/>
                                        <ComboBox fx:id="sPriority" promptText="Priority *" GridPane.columnIndex="1" maxWidth="Infinity"/>
                                        <TextArea fx:id="sDescription" promptText="Describe the issue *" prefRowCount="2" wrapText="true" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2"/>
                                        <Button text="Create ticket" onAction="#createTicket" styleClass="primary-large" GridPane.columnIndex="1" GridPane.rowIndex="2" maxWidth="Infinity"/>
                                    </GridPane>
                                </VBox>

                                <VBox spacing="10" styleClass="section-card,user-list-card" VBox.vgrow="ALWAYS">
                                    <HBox alignment="CENTER_LEFT">
                                        <VBox spacing="2">
                                            <Label text="Ticket history" styleClass="card-title"/>
                                            <Label text="Double-click a ticket to view its details." styleClass="muted,small-copy"/>
                                        </VBox>
                                        <Pane HBox.hgrow="ALWAYS"/>
                                        <HBox spacing="8">
                                            <Button text="View" onAction="#viewTicket" styleClass="secondary"/>
                                            <Button fx:id="ticketEditButton" text="Edit" onAction="#editTicket" styleClass="secondary"/>
                                            <Button fx:id="ticketDeleteButton" text="Delete" onAction="#deleteTicket" styleClass="danger"/>
                                        </HBox>
                                    </HBox>
                                    <TableView fx:id="ticketTable" minWidth="0" maxWidth="Infinity" VBox.vgrow="ALWAYS"/>
                                </VBox>

                                <VBox visible="false" managed="false">
                                    <ComboBox fx:id="sStatus"/>
                                    <TextArea fx:id="sResponse"/>
                                </VBox>
                            </VBox>

                        </content>

                    </Tab>


                    <!-- ================= REPORTS ================= -->

                    <Tab fx:id="tabReports"
                         text="Reports">

                        <content>

                            <VBox spacing="12" styleClass="content-page,reports-page">
                                <HBox alignment="CENTER_LEFT">
                                    <VBox spacing="2">
                                        <Label text="Reports" styleClass="page-title"/>
                                        <Label text="A concise overview of clinic activity and revenue." styleClass="muted"/>
                                    </VBox>
                                    <Pane HBox.hgrow="ALWAYS"/>
                                    <HBox spacing="8">
                                        <Button text="Refresh" onAction="#refreshReports" styleClass="secondary"/>
                                        <Button text="Download PDF" onAction="#downloadReport" styleClass="primary-large"/>
                                    </HBox>
                                </HBox>

                                <HBox spacing="10">
                                    <VBox spacing="5" styleClass="report-metric-card" HBox.hgrow="ALWAYS">
                                        <Label text="PATIENTS" styleClass="metric-label"/>
                                        <Label fx:id="reportPatients" text="0" styleClass="report-metric-value"/>
                                        <Label text="Registered records" styleClass="metric-note"/>
                                    </VBox>
                                    <VBox spacing="5" styleClass="report-metric-card" HBox.hgrow="ALWAYS">
                                        <Label text="APPOINTMENTS" styleClass="metric-label"/>
                                        <Label fx:id="reportAppointments" text="0" styleClass="report-metric-value"/>
                                        <Label text="All appointments" styleClass="metric-note"/>
                                    </VBox>
                                    <VBox spacing="5" styleClass="report-metric-card" HBox.hgrow="ALWAYS">
                                        <Label text="PAID BILLS" styleClass="metric-label"/>
                                        <Label fx:id="reportBills" text="0" styleClass="report-metric-value"/>
                                        <Label text="Saved payments" styleClass="metric-note"/>
                                    </VBox>
                                    <VBox spacing="5" styleClass="report-metric-card" HBox.hgrow="ALWAYS">
                                        <Label text="OPEN TICKETS" styleClass="metric-label"/>
                                        <Label fx:id="reportOpenTickets" text="0" styleClass="report-metric-value"/>
                                        <Label text="Require attention" styleClass="metric-note"/>
                                    </VBox>
                                </HBox>

                                <HBox spacing="12" VBox.vgrow="ALWAYS">
                                    <VBox spacing="6" styleClass="section-card,report-revenue-card">
                                        <Label text="TOTAL REVENUE" styleClass="metric-label"/>
                                        <Label fx:id="reportRevenue" text="Rs. 0.00" styleClass="report-revenue-value"/>
                                        <Label text="From all saved billing records" styleClass="muted,small-copy"/>
                                        <Pane VBox.vgrow="ALWAYS"/>
                                        <Label text="Last generated" styleClass="field-label"/>
                                        <Label fx:id="reportGeneratedAt" text="Not generated yet" styleClass="muted"/>
                                    </VBox>
                                    <VBox spacing="8" styleClass="section-card" HBox.hgrow="ALWAYS">
                                        <Label text="Report preview" styleClass="card-title"/>
                                        <TextArea fx:id="reportArea" editable="false" styleClass="receipt,report-preview" VBox.vgrow="ALWAYS"/>
                                    </VBox>
                                </HBox>
                            </VBox>

                        </content>

                    </Tab>

                </tabs>

            </TabPane>
        </HBox>

    </center>

</BorderPane>
