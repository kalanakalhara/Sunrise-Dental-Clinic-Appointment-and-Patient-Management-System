<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.mycompany.sunrisedentalclinic.controller.LoginController"
            stylesheets="@clinic.css" styleClass="login-root">
    <center>
        <HBox maxWidth="800" maxHeight="470" styleClass="login-shell">
            <VBox prefWidth="360" spacing="18" alignment="CENTER_LEFT" styleClass="brand-panel">
                <StackPane styleClass="logo-tile">
                    <ImageView fitWidth="142" fitHeight="142" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@dental_logo.png"/>
                        </image>
                    </ImageView>
                </StackPane>
                <Region prefHeight="12"/>
                <Label text="Bright smiles start here." wrapText="true" styleClass="brand-title"/>
                <Label text="A simple, reliable workspace for your clinic team, patients and appointments." wrapText="true" styleClass="brand-copy"/>
            </VBox>
            <VBox prefWidth="440" spacing="15" alignment="CENTER_LEFT" styleClass="login-panel">
                <Label text="SUNRISE DENTAL CLINIC" styleClass="eyebrow"/>
                <Label text="Welcome back" styleClass="login-title"/>
                <Label text="Sign in to continue to your clinic dashboard." styleClass="muted"/>
                <Region prefHeight="8"/>
                <Label text="Username" styleClass="muted"/>
                <TextField fx:id="txtUsername" promptText="Enter your username" prefHeight="44" maxWidth="Infinity"/>
                <Label text="Password" styleClass="muted"/>
                <PasswordField fx:id="txtPassword" promptText="Enter your password" prefHeight="44" maxWidth="Infinity" onAction="#login"/>
                <Button text="Sign in" onAction="#login" maxWidth="Infinity" prefHeight="46" styleClass="primary-large"/>
                <Label fx:id="lblMessage" wrapText="true" maxWidth="Infinity" minHeight="20" styleClass="error-label"/>
                <Region prefHeight="4"/>
                <!--    <Label text="Demo access: admin / admin123" styleClass="muted"/>-->
            </VBox>
        </HBox>
    </center>
    <padding>
        <Insets top="35" right="35" bottom="35" left="35"/>
    </padding>
</BorderPane>
